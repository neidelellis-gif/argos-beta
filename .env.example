# Chave de acesso ao provedor Finnhub (não inclua credenciais reais aqui).
FINNHUB_API_KEY=

# Ordem dos provedores diários, separados por vírgula (padrão: finnhub).
ARGOS_DAILY_PROVIDERS=

# Duração do cache local em segundos (opcional; padrão: 900).
ARGOS_DAILY_CACHE_TTL_SECONDS=

# Diretório do cache local (opcional; padrão: .cache/daily).
ARGOS_DAILY_CACHE_DIR=
